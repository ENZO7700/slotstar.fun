# ==================================================
# SLOTSTAR.FUN - ENVIRONMENT CONFIGURATION
# ==================================================

# Next.js Frontend Configuration
NEXT_PUBLIC_SITE_URL=https://slotstar.fun
NEXT_PUBLIC_SLOTSLAUNCH_REF_ID=wa1UHO8r

# Headless WordPress Backend URL
WORDPRESS_API_URL=https://cms.slotstar.fun/wp-json

# Security & Bridge Secret Keys (Set real random values on production server)
KSL_BRIDGE_SHARED_SECRET=
KSL_REVALIDATE_SECRET=
KSL_NEXT_REVALIDATE_URL=https://slotstar.fun/api/revalidate
KSL_NEXT_REVALIDATE_SECRET=

# Slots Launch API Configuration (Server-Side Secrets ONLY - Never expose to client)
SLOTSLAUNCH_REGISTERED_HOST=slotstar.fun
SLOTSLAUNCH_ORIGIN=https://slotstar.fun
KSL_SLOTSLAUNCH_TOKEN=
KSL_SLOTSLAUNCH_EMBED_TOKEN=
KSL_SLOTSLAUNCH_ORIGIN=https://slotstar.fun
KSL_SLOTSLAUNCH_RATE_LIMIT_RPS=0.45

# Application Settings
KSL_SOURCE_MODE=auto
KSL_REQUEST_TIMEOUT_MS=10000
KSL_ENABLE_LAUNCH=true
KSL_USE_FIXTURES=false
